# Copy to .env and fill in real values before `docker compose up`.
# .env is gitignored - never commit your real one.
#
# Any *_PASS / *_SECRET_KEY value here can instead be supplied via a
# "<NAME>_FILE=/path/to/secret" variable (Docker secrets convention) - see
# docker-compose.yml and docs/CONFIGURATION.md#docker--compose.

# --- AzerothCore's existing database (not bundled by this compose file) ---
# From inside the app container, 127.0.0.1 means the container itself, not
# your host - use your Docker host's LAN/VPN address, or a Compose network
# alias if AzerothCore's MySQL is also containerized on this same host.
WEB_DB_HOST=CHANGE_ME
WEB_DB_PORT=3306
WEB_DB_USER=CHANGE_ME
WEB_DB_PASS=CHANGE_ME
AUTH_DB=acore_auth
CHAR_DB=acore_characters
WORLD_DB=acore_world

# --- the panel's own bootstrap admin + session key ---
WEB_ADMIN_USER=CHANGE_ME
WEB_ADMIN_PASS=CHANGE_ME
# Generate with: openssl rand -hex 32
WEB_SECRET_KEY=CHANGE_ME
BOT_ACCOUNT_PREFIX=rndbot

# --- worldserver SOAP command interface (same "not 127.0.0.1" note as DB) ---
SOAP_HOST=CHANGE_ME
SOAP_PORT=7878
SOAP_USER=CHANGE_ME
SOAP_PASS=CHANGE_ME

# --- TLS proxy ---
# Host interface the proxy publishes on. Keep this a private/VPN address -
# never 0.0.0.0 or a public IP.
TLS_BIND_ADDR=127.0.0.1
HTTPS_PORT=443
HTTP_PORT=80
# Common Name for the self-signed fallback certificate.
TLS_CN=localhost
