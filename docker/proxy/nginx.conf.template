# Rendered by the official nginx image's own envsubst-templating entrypoint
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) into
# /etc/nginx/conf.d/default.conf at container start. Listens on all
# interfaces *inside the container* - docker-compose.yml controls which host
# interface/port that actually reaches, and only this proxy service is
# published to the host at all.
#
# Deliberately using ${VAR} names that cannot collide with nginx's own
# lowercase runtime variables ($host, $remote_addr, $request_uri, ...).

server {
    listen 8080;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5:!3DES;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:acorewebadmin_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 2m;

    location /healthz {
        proxy_pass http://${APP_HOST}:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        access_log off;
    }

    location / {
        proxy_pass http://${APP_HOST}:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_redirect off;
        proxy_read_timeout 60s;
    }
}
